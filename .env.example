# Copy to .env and adjust for docker compose. There is no secret-shaped
# configuration yet: no session, no OIDC, no CSRF and no form, so none of
# these need the envconf "_FILE" convention. docker-compose.yaml reads this
# file itself; bin/frontend and bin/api also run with none of these set,
# since every one of them has a usable default.
#
# Each variable below says which binary reads it: the frontend
# (internal/frontendconfig), the api (internal/apiconfig) or both.

# Both. Address the public HTTP server listens on.
# ADDR=:8080

# Both. Address govue's admin listener listens on: /healthz, /readyz and
# /metrics.
# ADMIN_ADDR=:8081

# Frontend only. This site's own public origin. The frontend reads its host
# name, which page views are reported under. The pages, the sitemap and
# robots.txt carry the origin the build was made with (VITE_SITE_URL).
# SITE_URL=https://simon-ostendorf.de

# Both. debug, info, warn or error.
# LOG_LEVEL=info

# Both. Comma separated CIDRs of the reverse proxies whose X-Forwarded-For
# header is believed. Behind a proxy, set this to the proxy range, or no
# visitor is counted by the frontend and the access logs show the proxy.
# TRUSTED_PROXIES=10.0.0.0/8

# Both. Drops the Strict-Transport-Security header, for a plain HTTP
# development run. docker-compose.yaml sets it. Never set it on anything
# reachable from outside the machine it runs on.
# ALLOW_PLAIN_HTTP=false

# Frontend only. Page view counting with Umami, from the server. Off unless
# both are set; setting only one is a startup error. Neither value is a
# secret.
# UMAMI_URL=https://umami.example.test
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# Optional: one post to Umami (1s to 30s) and the queue of waiting views.
# UMAMI_TIMEOUT=5s
# UMAMI_QUEUE_SIZE=256

# Frontend only, development only. The URL of the api container, which the
# frontend forwards /api/ to, so a compose stack has one browser origin as
# the Ingress gives production. Setting it also turns on govue's development
# mode. docker-compose.yaml sets it. The Helm chart never does.
# FRONTEND_DEV_API_PROXY=http://api:8080
