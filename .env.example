# Copy to .env and adjust for docker compose. There is no secret-shaped
# configuration yet: no session, no OIDC, no CSRF and no form, so none of
# these need the envconf "_FILE" convention. docker-compose.yaml reads this
# file itself; bin/website also runs with none of these set, since every
# one of them has a usable default.

# Address the public HTTP server listens on.
# ADDR=:8080

# Address govue's admin listener listens on: /healthz, /readyz and /metrics.
# ADMIN_ADDR=:8081

# This site's own public origin, the base /robots.txt and /sitemap.xml build
# every absolute URL from.
# SITE_URL=https://simon-ostendorf.de

# debug, info, warn or error.
# LOG_LEVEL=info

# Page view counting with Umami, from the server. Off unless both are set;
# setting only one is a startup error. Neither value is a secret.
# UMAMI_URL=https://umami.example.test
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# Optional: one post to Umami (1s to 30s) and the queue of waiting views.
# UMAMI_TIMEOUT=5s
# UMAMI_QUEUE_SIZE=256

# Comma separated CIDRs of the reverse proxies whose X-Forwarded-For header is
# believed. Behind a proxy, set this to the proxy range, or no visitor is
# counted.
# TRUSTED_PROXIES=10.0.0.0/8
