{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "simon-ostendorf-de",
  "type": "object",
  "required": ["image", "service"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "required": ["type", "port", "adminPort"],
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "annotations": { "type": "object" },
        "parentRefs": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the Gateway this HTTPRoute attaches to. Required when httpRoute.enabled is true; enforced by a template fail guard, not minLength, matching this chart's existing pattern for a value with no usable default."
            },
            "namespace": {
              "type": "string",
              "description": "Namespace the Gateway lives in. Required when httpRoute.enabled is true; see parentRefs.name's own description."
            },
            "sectionName": { "type": "string" }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "resources": { "type": "object" },
    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "config": {
      "type": "object",
      "properties": {
        "addr": { "type": "string", "minLength": 1 },
        "adminAddr": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "trustedProxies": {
          "type": "string",
          "description": "Comma separated CIDRs of trusted reverse proxies. A /0 range (0.0.0.0/0 or ::/0) is refused: it would trust X-Forwarded-For from any peer.",
          "not": { "pattern": "/0+($|[,\\s])" }
        }
      }
    },
    "umami": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "websiteId": { "type": "string" }
      }
    }
  }
}
