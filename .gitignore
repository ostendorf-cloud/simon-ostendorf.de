# macOS
.DS_Store

# Local secrets for docker compose; see .env.example.
.env*
!.env.example

# Agents
.claude/settings.local.json
.claude/.cc-writes/
.claude/worktrees/

# Go
*.exe
*.test
*.out
*.prof
coverage.out
bin/

# The built SPA, embedded by cmd/website: generated by task web:build,
# never written by hand or committed.
cmd/website/dist/

# The prerendered HTML per route and locale, embedded by cmd/website:
# generated by task prerender, never written by hand or committed.
cmd/website/prerendered/

# Node, for the web/ package
node_modules/
dist/
coverage/
*.log
*.tsbuildinfo
.eslintcache
web/test-results/
web/playwright-report/

# pnpm's content-addressable store, if ever pointed at a path inside the
# project with --store-dir; not used by a plain "pnpm install" here.
.pnpm-store/

# Task's scratch directory. `task test:helm` builds a helm plugin directory here
# rather than relying on helm's own, which a cached tool install never populates.
.task/
