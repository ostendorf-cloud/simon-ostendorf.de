{
  "name": "@ostendorf-cloud/simon-ostendorf-de-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prerender": "vite build --ssr scripts/prerender.ts --outDir .prerender-ssr --emptyOutDir && node .prerender-ssr/prerender.js && rm -rf .prerender-ssr && pnpm run check:legal",
    "check:legal": "govue-check-legal --dir ../cmd/website/prerendered",
    "theme:generate": "node node_modules/@ostendorf-cloud/govue/scripts/generate-theme.ts --config src/theme/seeds.json --out src/theme/simon-ostendorf-de.css",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ostendorf-cloud/govue": "ostendorf-cloud/govue#v0.5.0&path:/web",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.1.5",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.13"
  }
}
